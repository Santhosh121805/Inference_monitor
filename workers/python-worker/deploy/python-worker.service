[Unit]
Description=Python Inference Worker
Documentation=https://github.com/YOUR_USERNAME/inference-monitor
After=network.target
StartLimitIntervalSec=200
StartLimitBurst=5

[Service]
Type=simple
User=pyworker
WorkingDirectory=/opt/python-worker

# Override port or swap to a real model via Environment= directives
Environment=PYTHON_WORKER_PORT=8000

ExecStart=/usr/bin/python3 /opt/python-worker/worker.py

# Restart policy
Restart=on-failure
RestartSec=5

# Graceful shutdown
TimeoutStopSec=30
KillSignal=SIGTERM

# Logging → systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=python-worker

# Resource limits
LimitNOFILE=65536

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/python-worker

[Install]
WantedBy=multi-user.target
