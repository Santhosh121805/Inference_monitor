# Dockerfile for development
# Use for docker-compose local testing

FROM node:20-slim

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./

# Install dependencies (including dev)
RUN npm install

# Copy source code
COPY src ./src

# Expose port
EXPOSE 3000

# Watch and rebuild on changes
CMD ["npm", "run", "dev"]
