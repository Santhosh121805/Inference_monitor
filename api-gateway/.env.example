# API Gateway Environment Configuration
# 
# This file contains all configuration for the API Gateway.
# Copy to /etc/gateway/.env on production and fill in actual values.
# 
# REQUIRED VARIABLES:
# These must be set before the gateway starts. Startup will fail without them.

# Private IP:port of the Python worker (e.g., http://10.0.1.5:8000)
# This worker handles model loading and inference
PYTHON_WORKER_URL=http://10.0.1.5:8000

# Private IP:port of the TypeScript worker (e.g., http://10.0.1.6:3001)
# This worker handles pre/post-processing and chains to Python worker
TYPESCRIPT_WORKER_URL=http://10.0.1.6:3001

# 
# OPTIONAL VARIABLES:
# These have sensible defaults but can be overridden.

# Server listening port (default: 3000)
PORT=3000

# Request timeout in milliseconds (default: 30000)
# How long to wait for worker responses before timing out
REQUEST_TIMEOUT_MS=30000

# Log level: debug, info, warn, error (default: info)
# Set to debug for verbose RPC logging in development
LOG_LEVEL=info

# Node environment: development, production, test (default: production)
NODE_ENV=production

# Rate limit window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per IP per window (default: 60)
# Limits to 60 requests per minute per IP
RATE_LIMIT_MAX_REQUESTS=60
